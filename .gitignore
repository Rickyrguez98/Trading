# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
.installed.cfg
pip-wheel-metadata/

# Virtual environments
.env
.venv/
.venv*/
venv/
env/
ENV/
.pyenv/

# IDE / tooling
.vscode/
.idea/
*.swp
.DS_Store

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Notebook checkpoints
.ipynb_checkpoints/

# Project data (do not commit) -- domain-separated layout
data/*/input/*
data/*/raw/*
data/*/processed/*
data/*/cache/*
!data/*/input/.gitkeep
!data/*/raw/.gitkeep
!data/*/processed/.gitkeep
!data/*/cache/.gitkeep
# legacy flat layout (still ignored if present locally)
data/raw/*
data/processed/*
data/cache/*

# Reports (generated)
reports/*
!reports/us_equities/
!reports/binary_options/
reports/us_equities/*
reports/binary_options/*
!reports/us_equities/.gitkeep
!reports/binary_options/.gitkeep

# Logs
logs/
*.log

# Secrets
.env
.env.local
*.key
*.pem
